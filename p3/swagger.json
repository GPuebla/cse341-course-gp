{
  "swagger": "2.0",
  "info": {
    "title": "CargoQuote API",
    "description": "API for managing freight quotations, customers, carriers and ports - CSE 341",
    "version": "1.0.0"
  },
  "host": "localhost:5000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "sessionAuth": {
      "type": "apiKey",
      "in": "cookie",
      "name": "connect.sid",
      "description": "Session cookie set after logging in via GET /auth/github. Log in through a browser first, then use Swagger UI in that SAME browser tab so the cookie is sent automatically with \"Try it out\"."
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Welcome"
        ],
        "summary": "Welcome route",
        "description": "Welcome route / health check for the API.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/github": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in with GitHub",
        "description": "Redirects to GitHub to authorize this app. Open this URL directly in a browser tab (not via Swagger \"Try it out\", which cannot follow the GitHub login redirect).",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "GitHub OAuth callback",
        "description": "Called automatically by GitHub after authorization. Creates or updates the local user and starts the session. Not meant to be invoked directly.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/auth/failure": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Authentication failure",
        "description": "Returned when GitHub authorization did not succeed.",
        "responses": {
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out",
        "description": "Ends the current session and clears the session cookie.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/user": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get current logged-in user",
        "description": "Returns the profile of the currently authenticated user, or 401 if there is no active session. Log in via GET /auth/github in a browser first, then call this from the same browser session.",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "sessionAuth": []
          }
        ]
      }
    },
    "/customers/": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Get all customers",
        "description": "Returns the complete list of customers. Requires an active GitHub-authenticated session.",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "sessionAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Customers"
        ],
        "summary": "Create a customer",
        "description": "Creates a new customer. Requires an active GitHub-authenticated session.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Customer information",
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Ana Torres"
                },
                "email": {
                  "type": "string",
                  "example": "ana.torres@example.com"
                },
                "phone": {
                  "type": "string",
                  "example": "+54 11 5555-0100"
                },
                "company": {
                  "type": "string",
                  "example": "Torres Import/Export S.A."
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        },
        "security": [
          {
            "sessionAuth": []
          }
        ]
      }
    },
    "/customers/{customerId}": {
      "get": {
        "tags": [
