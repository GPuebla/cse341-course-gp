        ],
        "summary": "Delete a customer",
        "description": "Deletes a customer by their MongoDB ObjectId. Requires an active GitHub-authenticated session.",
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Customer MongoDB ObjectId",
            "example": "6a5fcf35bbd9c1e51975510d"
