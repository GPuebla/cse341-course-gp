            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Science Fiction"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        },
        "security": [
          {
            "sessionAuth": []
          }
        ]
      }
    },
    "/categories/{id}": {
      "get": {
        "tags": [
          "Categories"
        ],
        "summary": "Get category by id",
        "description": "Returns a single category by its MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Category MongoDB ObjectId",
            "example": "6a610012beb4c4d3b32c9b50"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Categories"
        ],
        "summary": "Update a category",
        "description": "Updates an existing category. Requires an active GitHub-authenticated session.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
