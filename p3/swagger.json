          }
        ]
      },
      "delete": {
        "tags": [
          "Categories"
        ],
        "summary": "Delete a category",
        "description": "Deletes a category by its MongoDB ObjectId. Requires an active GitHub-authenticated session.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Category MongoDB ObjectId",
            "example": "6a610012beb4c4d3b32c9b50"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "sessionAuth": []
          }
        ]
      }
    }
  }
}