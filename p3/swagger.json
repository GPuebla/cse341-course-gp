        "summary": "Create a quotation",
        "description": "Creates a new quotation. Requires an active GitHub-authenticated session.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Quotation information",
            "schema": {
              "type": "object",
              "properties": {
                "customerId": {
                  "type": "string",
                  "example": "6a5fcf35bbd9c1e51975510d"
                },
                "carrierId": {
                  "type": "string",
                  "example": "6a610012beb4c4d3b32c9b50"
                },
                "origin": {
                  "type": "string",
                  "example": "Puerto de Buenos Aires"
                },
                "destination": {
                  "type": "string",
                  "example": "Rotterdam"
                },
                "cargoType": {
                  "type": "string",
                  "example": "general"
                },
                "weight": {
                  "type": "number",
                  "example": 12000
                },
                "volume": {
                  "type": "number",
                  "example": 28.5
                },
                "rate": {
                  "type": "number",
                  "example": 2450
                },
                "currency": {
                  "type": "string",
                  "example": "USD"
                },
                "status": {
                  "type": "string",
                  "example": "draft"
                },
                "validUntil": {
                  "type": "string",
                  "example": "2026-12-31"
                }
              }
            }
