                  "type": "string",
                  "example": "Ana Torres"
                },
                "email": {
                  "type": "string",
                  "example": "ana.torres@example.com"
                },
                "phone": {
                  "type": "string",
                  "example": "+54 11 5555-0100"
                },
                "company": {
                  "type": "string",
                  "example": "Torres Import/Export S.A."
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "sessionAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
