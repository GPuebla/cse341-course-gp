# MongoDB connection string (already required by data/db.js)
MONGODB_URL=

# Secret used to sign the session cookie. Any long random string works.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# From your GitHub OAuth App (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://cse341-course-gp-9bp4.onrender.com/auth/github/callback
