            "type": "string",
            "description": "Book MongoDB ObjectId",
            "example": "6a700001aed1842b4a131001"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Updated book information",
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "example": "Harry Potter and the Philosopher's Stone"
                },
                "isbn": {
                  "type": "string",
                  "example": "9780747532699"
                },
                "publicationYear": {
                  "type": "number",
                  "example": 1997
                },
                "pages": {
                  "type": "number",
                  "example": 320
                },
                "available": {
                  "type": "boolean",
                  "example": true
                },
                "authorId": {
                  "type": "string",
                  "example": "6a5fcf35bbd9c1e51975510d"
                },
                "categoryId": {
                  "type": "string",
                  "example": "6a610012beb4c4d3b32c9b50"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Books"
        ],
        "summary": "Delete a book",
        "description": "Deletes a book by its MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Book MongoDB ObjectId",
            "example": "6a700001aed1842b4a131001"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
