{
  "swagger": "2.0",
  "info": {
    "title": "Books API",
    "description": "API for managing books - CSE 341",
    "version": "1.0.0"
  },
  "host": "localhost:5000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Welcome"
        ],
        "summary": "Welcome route",
        "description": "Welcome route / health check for the API.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/books/": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get all books",
        "description": "Returns the complete list of books.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Create a book",
        "description": "Creates a new book.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Book information",
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "example": "Harry Potter and the Philosopher's Stone"
                },
                "isbn": {
                  "type": "string",
                  "example": "9780747532699"
                },
                "publicationYear": {
                  "type": "number",
                  "example": 1997
                },
                "pages": {
                  "type": "number",
                  "example": 320
                },
                "available": {
                  "type": "boolean",
                  "example": true
                },
                "authorId": {
                  "type": "string",
                  "example": "6a5fcf35bbd9c1e51975510d"
                },
                "categoryId": {
                  "type": "string",
                  "example": "6a610012beb4c4d3b32c9b50"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/books/author/{authorId}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get books by author",
        "description": "Returns all books written by the specified author.",
        "parameters": [
          {
            "name": "authorId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Author MongoDB ObjectId",
            "example": "6a5fcf35bbd9c1e51975510d"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/books/category/{categoryId}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get books by category",
        "description": "Returns all books that belong to the specified category.",
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Category MongoDB ObjectId",
            "example": "6a610012beb4c4d3b32c9b50"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Get book by id",
        "description": "Returns a single book by its MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Book MongoDB ObjectId",
            "example": "6a700001aed1842b4a131001"
